# Copie para .env.local (nunca commitar .env.local — já está no .gitignore).
# Na Vercel, configure estas mesmas chaves em Project Settings > Environment Variables.

# --- Público (client-safe) ---
# Pixel ID da Meta. É público por natureza: aparece no HTML de qualquer forma.
NEXT_PUBLIC_META_PIXEL_ID=

# Número de WhatsApp em formato internacional, só dígitos (ex: 5588999999999).
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Texto pré-preenchido da mensagem (sem código/hash — mensagem limpa para o lead).
NEXT_PUBLIC_WHATSAPP_MESSAGE=Quero saber mais

# core.tenants.id do Supabase (novo_formato/schema.sql). Cada deploy da
# landing serve 1 cliente; este valor precisa bater com o id cadastrado no
# banco. Ver README "Onboarding de cliente novo".
NEXT_PUBLIC_TENANT_ID=

# --- Privado (nunca prefixar com NEXT_PUBLIC_, nunca expor ao client) ---
# Project URL e service_role key do Supabase (Project Settings > API).
# service_role IGNORA RLS — nunca deixar vazar para o client.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
